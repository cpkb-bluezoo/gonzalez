<?xml version="1.0" encoding="UTF-8"?>
<!--
  This POM declares Maven coordinates and the metadata Maven Central's
  Publisher API validates (name/description/url/licenses/developers/scm)
  for the "core" artifact (parser, writer, DTD support - zero external
  dependencies). It performs no build or deploy action of its own: Ant
  (build.xml) is the sole build tool, and this file is only consumed by
  scripts/publish-to-central.sh when assembling the Central upload bundle.

  Gonzalez publishes three separate Central coordinates from one source
  tree - see also gonzalez-xslt-pom.xml and gonzalez-pom.xml (the fat/
  combined artifact) in this same directory. This is unrelated to the
  root pom.xml, which is a distribution POM for GitHub Packages, driven
  by a standalone `mvn deploy:deploy-file` invocation (see
  .github/workflows/release-to-github-packages.yml) that does not consume
  any of these three files.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.bluezoo</groupId>
    <artifactId>gonzalez-core</artifactId>
    <version>1.3.0</version>
    <packaging>jar</packaging>

    <name>Gonzalez (Core)</name>
    <description>Non-blocking streaming XML parser for event-driven I/O - core parser, writer, and DTD support, with zero external dependencies.</description>
    <url>https://github.com/cpkb-bluezoo/gonzalez</url>

    <licenses>
        <license>
            <name>GNU Lesser General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Chris Burdess</name>
            <email>dog@gnu.org</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/cpkb-bluezoo/gonzalez.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/cpkb-bluezoo/gonzalez.git</developerConnection>
        <url>https://github.com/cpkb-bluezoo/gonzalez</url>
    </scm>

</project>
