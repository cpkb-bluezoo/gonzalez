    <get src='https://repo1.maven.org/maven2/org/xmlresolver/xmlresolver/${xmlresolver.version}/xmlresolver-${xmlresolver.version}-data.jar'
         dest='${lib}/${xmlresolver.data.jar}'
         skipexisting='true'
         verbose='true'/>
