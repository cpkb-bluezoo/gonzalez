  <!-- Real documents for the comparison with other parsers
       (benchmark/external-compare): a French and a German novel in TEI XML
       from the ELTeC collections (github.com/COST-ELTeC; the texts are in the
       public domain, and the German markup is CC BY 4.0). They are downloaded
       and not kept in the repository, each from a fixed commit of its
       collection, and checked against the SHA-256 of the document that was
       measured, so that a build cannot be measuring other text. -->
  <property name='benchmark.corpora' location='benchmark/corpora'/>
  <property name='eltec.fra.commit' value='83f0a43fdb967cd1db646027a1a237307e4924a1'/>
  <property name='eltec.deu.commit' value='dd1529ae19fda711fa23c908f86bfa6e474e9412'/>
  <property name='eltec.fra.file' value='FRA03601_Proust.xml'/>
  <property name='eltec.deu.file' value='DEU037.xml'/>
  <property name='eltec.fra.sha256' value='eae4b3d3b7424e3da9e2e8e1b1f58fa640b8dc8470aaf9c733c33459fa6d2996'/>
  <property name='eltec.deu.sha256' value='2a39aadd9294e43b6bf8f075916e83642ea6532bd82688a2579e27e05d9479af'/>

  <!-- A download that is checked against a SHA-256 before it is used: kept if
       it matches, and deleted, with the build failing, if it does not. -->
  <macrodef name='fetch-verified'>
    <attribute name='url'/>
    <attribute name='dir'/>
    <attribute name='file'/>
    <attribute name='sha256'/>
    <sequential>
      <get src='@{url}' dest='@{dir}/@{file}' skipexisting='true' verbose='true'/>
      <checksum file='@{dir}/@{file}' algorithm='SHA-256'
                property='@{sha256}' verifyproperty='checked.@{file}'/>
      <condition property='valid.@{file}'>
        <equals arg1='${checked.@{file}}' arg2='true'/>
      </condition>
      <delete file='@{dir}/@{file}' unless:set='valid.@{file}' xmlns:unless='ant:unless'/>
      <fail message='@{file} is not the file expected (SHA-256 @{sha256}); it has been removed.'
            unless='valid.@{file}'/>
    </sequential>
  </macrodef>

  <target name='download-corpora'
          description='Download the French and German novels for the parser comparison'>
    <mkdir dir='${benchmark.corpora}'/>
    <fetch-verified
        url='https://raw.githubusercontent.com/COST-ELTeC/ELTeC-fra/${eltec.fra.commit}/level1/${eltec.fra.file}'
        dir='${benchmark.corpora}' file='${eltec.fra.file}' sha256='${eltec.fra.sha256}'/>
    <fetch-verified
        url='https://raw.githubusercontent.com/COST-ELTeC/ELTeC-deu/${eltec.deu.commit}/level1/${eltec.deu.file}'
        dir='${benchmark.corpora}' file='${eltec.deu.file}' sha256='${eltec.deu.sha256}'/>
    <echo message='French and German documents are in ${benchmark.corpora}'/>
  </target>

  <!-- The parser that Gonzalez is compared with (and its API jar). Not a
       product dependency: only the comparison uses them, checked against the
       SHA-256 of the jars published on Maven Central. -->
  <property name='aalto.version' value='1.4.0'/>
  <property name='stax2.version' value='4.3.0'/>
  <property name='aalto.jar' location='${lib}/aalto-xml-${aalto.version}.jar'/>
  <property name='stax2.jar' location='${lib}/stax2-api-${stax2.version}.jar'/>
  <property name='aalto.sha256' value='1811be73195cad1d11f609c1f6527ca74a4ae1484bef73c6acaa0491991e5765'/>
  <property name='stax2.sha256' value='7c805f36129ea9fa42b696093b7ae1eb20bb6ccec65c8280d6f33db5609ca5e1'/>

  <target name='download-comparison-deps' description='Download aalto-xml, which the comparison measures Gonzalez against'>
    <mkdir dir='${lib}'/>
    <fetch-verified
        url='https://repo1.maven.org/maven2/com/fasterxml/aalto-xml/${aalto.version}/aalto-xml-${aalto.version}.jar'
        dir='${lib}' file='aalto-xml-${aalto.version}.jar' sha256='${aalto.sha256}'/>
    <fetch-verified
        url='https://repo1.maven.org/maven2/org/codehaus/woodstox/stax2-api/${stax2.version}/stax2-api-${stax2.version}.jar'
        dir='${lib}' file='stax2-api-${stax2.version}.jar' sha256='${stax2.sha256}'/>
  </target>

  <!-- The comparison with the JDK's parser and aalto-xml, by the scripts of
       benchmark/external-compare. Each target builds Gonzalez, fetches what it
       is measured against (and the documents, where it uses them), and runs
       its script with the jars and the build. The scripts can also be run on
       their own, for more control, with AALTO_JAR and STAX2_JAR set. -->
  <macrodef name='comparison-script'>
    <attribute name='script'/>
    <element name='arguments' implicit='yes' optional='yes'/>
    <sequential>
      <exec executable='bash' dir='${basedir}' failonerror='true'>
        <arg value='benchmark/external-compare/@{script}'/>
        <arguments/>
        <env key='AALTO_JAR' file='${aalto.jar}'/>
        <env key='STAX2_JAR' file='${stax2.jar}'/>
        <env key='GONZALEZ_CLASSES' file='${build.core}'/>
      </exec>
    </sequential>
  </macrodef>

  <!-- The tables of PERFORMANCE.md (performance-tables.sh). -Dbenchmark.reps=N is
       how many fresh JVMs each figure is the median of,
       -Dbenchmark.compare.corpora="plain accent" limits it to some of the
       documents, and -Dbenchmark.report=FILE is where the tables are written. -->
  <property name='benchmark.reps' value='5'/>
  <property name='benchmark.compare.corpora' value=''/>
  <property name='benchmark.report' location='${build}/performance.md'/>

  <target name='benchmark-compare'
          depends='build-core,download-comparison-deps,download-corpora'
          description='Compare with the JDK parser and aalto-xml; tables are printed and written to build/performance.md'>
    <mkdir dir='${build}'/>
    <echo message='Comparing, with ${benchmark.reps} JVMs for each figure. This takes a long time.'/>
    <comparison-script script='performance-tables.sh'>
      <arg value='${benchmark.reps}'/>
      <arg value='${benchmark.report}'/>
      <env key='CORPORA' value='${benchmark.compare.corpora}'/>
    </comparison-script>
    <concat><fileset file='${benchmark.report}'/></concat>
    <echo message='The tables are in ${benchmark.report}'/>
  </target>

  <!-- One figure for each corpus and mode, each the median of fresh JVMs
       (run-isolated.sh), for looking at some of them, or at a build with a change
       in it. -Dbenchmark.isolated.corpora and -Dbenchmark.isolated.modes are
       quoted lists, by default all of them (see the script for their names),
       -Dbenchmark.reps is as above, and -Dbenchmark.isolated.unit=us gives
       microseconds for a parse and not MB/s. -->
  <property name='benchmark.isolated.corpora' value=''/>
  <property name='benchmark.isolated.modes' value=''/>
  <property name='benchmark.isolated.unit' value=''/>

  <target name='benchmark-isolated'
          depends='build-core,download-comparison-deps,download-corpora'
          description='Throughput of chosen corpora and modes, each the median of fresh JVMs'>
    <comparison-script script='run-isolated.sh'>
      <arg value='${benchmark.reps}'/>
      <arg value='${benchmark.isolated.corpora}'/>
      <arg value='${benchmark.isolated.modes}'/>
      <env key='UNIT' value='${benchmark.isolated.unit}'/>
    </comparison-script>
  </target>

  <!-- Whether each parser processes the internal DTD subset (run-dtd-probe.sh):
       what each reports for the XHTML document, which is the reason Aalto is
       not compared on it. -->
  <target name='benchmark-dtd-probe'
          depends='build-core,download-comparison-deps'
          description='Show which parsers process an internal DTD subset'>
    <comparison-script script='run-dtd-probe.sh'/>
  </target>

  <!-- Which parsers get to the end of one very large construct (a text node, a
       CDATA section, an attribute value, a comment) in a small heap
       (run-memory.sh). -Dbenchmark.memory.mb=N is the size of the construct and
       -Dbenchmark.memory.heap=Nm the heap. -->
  <property name='benchmark.memory.mb' value='256'/>
  <property name='benchmark.memory.heap' value='32m'/>

  <target name='benchmark-memory'
          depends='build-core,download-comparison-deps'
          description='Compare how the parsers cope with one very large construct in a small heap'>
    <comparison-script script='run-memory.sh'>
      <arg value='${benchmark.memory.mb}'/>
      <arg value='${benchmark.memory.heap}'/>
    </comparison-script>
  </target>

  <target name='build-benchmark' depends='build,download-jmh' description='Compile JMH benchmarks'>
    <mkdir dir='${benchmark.build}'/>
    <javac srcdir='${benchmark.src}' 
           destdir='${benchmark.build}' 
           debug='true' 
           includeantruntime='false'>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${build.xslt}'/>
        <pathelement location='lib/jsonparser-1.3.jar'/>
        <pathelement location='lib/jmh-core-${jmh.version}.jar'/>
        <pathelement location='lib/jmh-generator-annprocess-${jmh.version}.jar'/>
        <pathelement location='lib/jopt-simple-5.0.4.jar'/>
        <pathelement location='lib/commons-math3-3.6.1.jar'/>
