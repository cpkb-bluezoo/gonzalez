      <arg value='org.bluezoo.gonzalez.benchmark.XMLParserBenchmark'/>
    </java>
  </target>

  <target name='benchmark-xslt' depends='build-benchmark' description='Run XSLT hot-path JMH benchmarks'>
    <echo message='Running XSLT hot-path JMH benchmarks...'/>
    <java classname='org.openjdk.jmh.Main' fork='true'>
