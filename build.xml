<project name='gonzalez' default='dist'>

  <property environment='env'/>
  <property name='src' location='src'/>
  <property name='build' location='build'/>
  <property name='dist' location='dist'/>
  <property name='test' location='test'/>
  <property name='doc' location='doc'/>
  <property name='lib' location='lib'/>
  <!-- External parsing library dependency (downloaded by resolve-deps target) -->
  <property name='jsonparser.jar' value='jsonparser-1.3.jar'/>
  
  <!-- Gonzalez version -->
  <property name='version' value='1.3.0'/>
  <property name='gonzalez.jar' location='${dist}/gonzalez-${version}.jar'/>
  <property name='gonzalez.core.jar' location='${dist}/gonzalez-core-${version}.jar'/>
  <property name='gonzalez.xslt.jar' location='${dist}/gonzalez-xslt-${version}.jar'/>
  <property name='build.core' location='${build}/core'/>
  <property name='build.xslt' location='${build}/xslt'/>
  <property name='xslt.srcdir' location='${build}/xslt-src'/>

  <!-- Minimum Java version for runtime (APIs used require Java 8) -->
  <property name='java.release.version' value='8'/>
  <!-- Fallback for JDK 8 builds (source/target used when release attr unavailable) -->
  <property name='java.source.version' value='1.8'/>
  <property name='java.target.version' value='1.8'/>
  
  <!-- JUnit dependencies -->
  <property name='junit.jar' value='junit-4.13.1.jar'/>
  <property name='hamcrest.jar' value='hamcrest-3.0.jar'/>

  <!-- Clean build artifacts -->
  <target name='clean' depends='clean-test'>
    <delete dir='${build}'/>
    <delete dir='${dist}'/>
    <delete dir='${doc}'/>
  </target>
  
  <target name='clean-test'>
    <delete dir='${test}/junit/classes'/>
    <delete dir='${test}/junit/results'/>
    <delete dir='${test}/conformance/classes'/>
    <delete dir='${test}/output'/>
  </target>

  <!-- Download external parsing library dependencies from GitHub Releases -->
  <target name='resolve-deps' description='Download external dependencies'>
    <mkdir dir='${lib}'/>
    <get src='https://github.com/cpkb-bluezoo/jsonparser/releases/download/v1.3/jsonparser-1.3.jar'
         dest='${lib}/${jsonparser.jar}' skipexisting='true'/>
  </target>

  <!-- Compile core (parser, writer, DTD) - zero external dependencies -->
  <target name='build-core'>
    <mkdir dir='${build.core}'/>
    <javac srcdir='${src}' destdir='${build.core}' debug='true' includeantruntime='false'
           release='${java.release.version}'
           source='${java.source.version}' target='${java.target.version}'>
      <!-- Java 8 is the deliberate floor, so a newer JDK's note that source and
           target 8 are obsolete is expected and is not shown. -->
      <compilerarg value='-Xlint:-options'/>
      <exclude name='**/transform/**'/>
      <exclude name='**/schema/**'/>
      <exclude name='module-info.java'/>
    </javac>
    <javac srcdir='${src}' destdir='${build.core}' debug='true' includeantruntime='false'
           release='9'>
      <modulepath/>
      <include name='module-info.java'/>
    </javac>
  </target>

  <!-- Prepare XSLT source tree (module-info + transform + schema packages) -->
  <target name='prepare-xslt-src'>
    <mkdir dir='${xslt.srcdir}'/>
    <copy file='module/xslt/module-info.java' tofile='${xslt.srcdir}/module-info.java'/>
    <copy todir='${xslt.srcdir}'>
      <fileset dir='${src}'>
        <include name='org/bluezoo/gonzalez/transform/**'/>
        <include name='org/bluezoo/gonzalez/schema/**'/>
      </fileset>
    </copy>
  </target>

  <!-- Compile XSLT and schema (depends on core, requires jsonparser) -->
  <target name='build-xslt' depends='build-core,resolve-deps,prepare-xslt-src'>
    <mkdir dir='${build.xslt}'/>
    <javac srcdir='${xslt.srcdir}' destdir='${build.xslt}' debug='true' includeantruntime='false'
           release='${java.release.version}'
           source='${java.source.version}' target='${java.target.version}'>
      <!-- Java 8 is the deliberate floor, so a newer JDK's note that source and
           target 8 are obsolete is expected and is not shown. -->
      <compilerarg value='-Xlint:-options'/>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
      </classpath>
      <exclude name='module-info.java'/>
    </javac>
    <javac srcdir='${xslt.srcdir}' destdir='${build.xslt}' debug='true' includeantruntime='false'
           release='9'>
      <modulepath>
        <pathelement location='${build.core}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
      </modulepath>
      <include name='module-info.java'/>
    </javac>
    <copy todir='${build.xslt}'>
      <fileset dir='${src}'>
        <include name='META-INF/xslt20.xsd'/>
        <include name='META-INF/xslt30.xsd'/>
        <include name='META-INF/xslt-attributes.properties'/>
        <include name='META-INF/xsd-type-hierarchy.properties'/>
      </fileset>
    </copy>
    <copy todir='${build.xslt}'>
      <fileset dir='${src}'>
        <include name='org/bluezoo/gonzalez/transform/**/*.properties'/>
        <include name='org/bluezoo/gonzalez/schema/**/*.properties'/>
      </fileset>
    </copy>
  </target>

  <!-- Compile (core + xslt for tests and fat jar) -->
  <target name='build' depends='build-core,build-xslt'/>

  <!-- Create core JAR (parser, writer, DTD only - zero dependencies) -->
  <target name='jar-core' depends='build-core'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gonzalez.core.jar}' basedir='${build.core}'>
      <manifest>
        <attribute name='Implementation-Title' value='Gonzalez XML Parser (Core)'/>
        <attribute name='Implementation-Version' value='${version}'/>
        <attribute name='Implementation-Vendor' value='Chris Burdess'/>
      </manifest>
      <fileset dir='${src}'>
        <include name='META-INF/services/javax.xml.parsers.SAXParserFactory'/>
      </fileset>
    </jar>
  </target>

  <!-- Create XSLT JAR (transformer + schema, requires core + jsonparser) -->
  <target name='jar-xslt' depends='build-xslt'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gonzalez.xslt.jar}' basedir='${build.xslt}'>
      <manifest>
        <attribute name='Implementation-Title' value='Gonzalez XSLT Transformer'/>
        <attribute name='Implementation-Version' value='${version}'/>
        <attribute name='Implementation-Vendor' value='Chris Burdess'/>
      </manifest>
      <fileset dir='${src}'>
        <include name='META-INF/services/javax.xml.transform.TransformerFactory'/>
      </fileset>
    </jar>
  </target>

  <!-- Create fat JAR (core + xslt combined for backward compatibility) -->
  <target name='jar-all' depends='build'>
    <property name='build.fat' location='${build}/fat'/>
    <mkdir dir='${build.fat}'/>
    <copy todir='${build.fat}'>
      <fileset dir='${build.core}'/>
    </copy>
    <copy todir='${build.fat}'>
      <fileset dir='${build.xslt}' excludes='module-info.class'/>
    </copy>
    <delete file='${build.fat}/module-info.class' failonerror='false'/>
    <copy file='module/full/module-info.java' tofile='${build.fat}/module-info.java'/>
    <javac srcdir='${build.fat}' destdir='${build.fat}' debug='true' includeantruntime='false'
           release='9'>
      <include name='module-info.java'/>
      <modulepath>
        <pathelement location='${lib}/${jsonparser.jar}'/>
      </modulepath>
    </javac>
    <mkdir dir='${dist}'/>
    <jar destfile='${gonzalez.jar}' basedir='${build.fat}'>
      <manifest>
        <attribute name='Implementation-Title' value='Gonzalez XML Parser'/>
        <attribute name='Implementation-Version' value='${version}'/>
        <attribute name='Implementation-Vendor' value='Chris Burdess'/>
      </manifest>
      <fileset dir='${src}'>
        <include name='META-INF/services/*'/>
        <include name='META-INF/*.xsd'/>
        <include name='META-INF/*.properties'/>
      </fileset>
    </jar>
  </target>

  <!-- Legacy alias -->
  <target name='jar' depends='jar-all'/>

  <!-- API documentation. Depends only on resolve-deps (a jar download, not
       a compile) so that classes referencing org.bluezoo.json.* (from the
       transform package) can be resolved - without this classpath entry,
       javadoc silently emits "cannot find symbol" errors for those classes
       (Ant's javadoc task does not fail the build on javac-style errors),
       producing broken docs instead of a build failure. module-info.java
       is excluded: its presence puts javadoc into module mode, and since
       jsonparser.jar has no module descriptor of its own, strong
       encapsulation then blocks visibility into it ("package ... is not
       visible ... module ... does not read it") even with the classpath
       entry above - a plain classpath-mode scan avoids that entirely and
       is sufficient for docs. -->
  <target name='javadoc' depends='resolve-deps'>
    <mkdir dir='${doc}'/>
    <javadoc destdir='${doc}'>
      <classpath>
        <pathelement location='${lib}/${jsonparser.jar}'/>
      </classpath>
      <fileset dir='${src}'>
        <include name='**/*.java'/>
        <exclude name='module-info.java'/>
      </fileset>
    </javadoc>
  </target>

  <!-- Distribution target: core, xslt, and fat jars -->
  <target name='dist' depends='jar-core,jar-xslt,jar-all'/>

  <!-- Sources jar for Maven Central (core module only) - mirrors jar-core's
       own package excludes. No depends: archiving .java files needs no
       compile step first. -->
  <target name='release-sources-core'>
    <mkdir dir='${dist}'/>
    <jar jarfile='${dist}/gonzalez-core-${version}-sources.jar'>
      <fileset dir='${src}'>
        <exclude name='org/bluezoo/gonzalez/transform/**'/>
        <exclude name='org/bluezoo/gonzalez/schema/**'/>
      </fileset>
    </jar>
  </target>

  <!-- Sources jar for Maven Central (XSLT module only) - jars the same
       already-assembled tree build-xslt itself compiles from. Depends
       only on prepare-xslt-src (file copying), not on any compile. -->
  <target name='release-sources-xslt' depends='prepare-xslt-src'>
    <mkdir dir='${dist}'/>
    <jar jarfile='${dist}/gonzalez-xslt-${version}-sources.jar' basedir='${xslt.srcdir}'/>
  </target>

  <!-- Sources jar for Maven Central (fat jar: core + xslt combined) -
       mirrors jar-all's own module-info.java substitution. -->
  <target name='release-sources-fat'>
    <mkdir dir='${dist}'/>
    <jar jarfile='${dist}/gonzalez-${version}-sources.jar'>
      <fileset dir='${src}'>
        <exclude name='module-info.java'/>
      </fileset>
      <zipfileset file='module/full/module-info.java' fullpath='module-info.java'/>
    </jar>
  </target>

  <target name='release-sources' depends='release-sources-core,release-sources-xslt,release-sources-fat'/>

  <!-- Javadoc jar for Maven Central - one shared javadoc build (covering
       the whole source tree) reused for all three published artifacts;
       see scripts/publish-to-central.sh, which copies/renames this single
       jar into each artifact's bundle. No depends="build": javadoc
       generation is a source-level operation and needs nothing compiled
       first (see jsonparser's build.xml for the bug this avoids). -->
  <target name='release-javadoc' depends='javadoc'>
    <mkdir dir='${dist}'/>
    <jar jarfile='${dist}/gonzalez-${version}-javadoc.jar' basedir='${doc}'/>
  </target>

  <!-- Everything scripts/publish-to-central.sh needs in ${dist}: the
       three main jars, their three sources jars, and the one shared
       javadoc jar. -->
  <target name='release-central' depends='dist,release-sources,release-javadoc'
          description='Build all artifacts needed for a Maven Central publish'/>

  <!-- Download JUnit test framework dependencies from Maven Central -->
  <target name='resolve-test-deps' description='Download JUnit test dependencies'>
    <mkdir dir='${test}/junit/lib'/>
    <get src='https://repo1.maven.org/maven2/junit/junit/4.13.1/junit-4.13.1.jar'
         dest='${test}/junit/lib/${junit.jar}' skipexisting='true'/>
    <get src='https://repo1.maven.org/maven2/org/hamcrest/hamcrest/3.0/hamcrest-3.0.jar'
         dest='${test}/junit/lib/${hamcrest.jar}' skipexisting='true'/>
  </target>

  <!-- Unit test compilation -->
  <target name='junit-build' depends='build,resolve-test-deps'>
    <mkdir dir='${test}/junit/classes'/>
    <javac srcdir='${test}/junit/src' destdir='${test}/junit/classes' debug='true' includeantruntime='false'
           release='${java.release.version}'
           source='${java.source.version}' target='${java.target.version}'>
      <!-- Java 8 is the deliberate floor, so a newer JDK's note that source and
           target 8 are obsolete is expected and is not shown. -->
      <compilerarg value='-Xlint:-options'/>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${build.xslt}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
      </classpath>
    </javac>
  </target>
  
  <!-- Conformance test compilation -->
  <target name='conformance-build' depends='build,resolve-test-deps'>
    <mkdir dir='${test}/conformance/classes'/>
    <javac srcdir='${test}/conformance/src' destdir='${test}/conformance/classes' debug='true' includeantruntime='false'
           release='${java.release.version}'
           source='${java.source.version}' target='${java.target.version}'>
      <!-- Java 8 is the deliberate floor, so a newer JDK's note that source and
           target 8 are obsolete is expected and is not shown. -->
      <compilerarg value='-Xlint:-options'/>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${build.xslt}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
      </classpath>
    </javac>
  </target>
  
  <!-- Run unit tests -->
  <target name='test-unit' depends='junit-build' description='Run unit tests'>
    <mkdir dir='${test}/junit/results'/>
    <junit printsummary='yes' haltonfailure='no' fork='yes' showoutput='true'
           failureproperty='unit.tests.failed'>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${build.xslt}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${test}/junit/classes'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
      </classpath>
      <formatter type='xml'/>
      <formatter type='plain' usefile='false'/>
      <batchtest fork='yes' todir='${test}/junit/results'>
        <fileset dir='${test}/junit/src'>
          <include name='**/*Test.java'/>
        </fileset>
      </batchtest>
    </junit>
    
    <echo message=''/>
    <echo message='Unit test results written to ${test}/junit/results'/>
    
    <fail if='unit.tests.failed' message='Unit test failures detected.'/>
  </target>
  
  <!-- Run XML conformance tests -->
  <target name='test-conformance' depends='conformance-build' description='Run W3C XML conformance tests'>
    <mkdir dir='${test}/junit/results'/>
    <mkdir dir='${test}/output'/>
    <junit printsummary='yes' haltonfailure='no' fork='yes' showoutput='true'
           failureproperty='conformance.tests.failed'>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${build.xslt}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${test}/conformance/classes'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
      </classpath>
      <formatter type='xml'/>
      <formatter type='plain' usefile='false'/>
      <batchtest fork='yes' todir='${test}/junit/results'>
        <fileset dir='${test}/conformance/src'>
          <include name='**/XMLConformanceTest.java'/>
        </fileset>
      </batchtest>
    </junit>
    
    <echo message=''/>
    <echo message='Conformance report written to ${test}/output/xml-conformance-report.txt'/>
    <echo message=''/>
    <echo message='=== XML Conformance Test Statistics ==='/>
    <echo message=''/>
    <available file='${test}/output/conformance-statistics.txt' property='stats.file.exists'/>
    <loadfile property='stats.content' srcFile='${test}/output/conformance-statistics.txt' failonerror='false' quiet='true'/>
    <echo message='${stats.content}'/>
    
    <fail if='conformance.tests.failed'
          message='Conformance test failures detected. See report: ${test}/output/xml-conformance-report.txt'/>
  </target>

  <!-- Run W3C XML conformance tests against the new async Scanner pipeline
       (Scanner -> NamespaceFilter -> SAXAdapter, via ScannerXMLReader)
       instead of the old, still-default parser. Same harness, same
       manifest/scoring logic as test-conformance - only the device under
       test (via -Dgonzalez.conformance.parser=scanner) and the report file
       names (suffixed "-scanner") differ, so results can be compared
       side by side without one run clobbering the other's report. -->
  <target name='test-conformance-scanner' depends='conformance-build'
          description='Run W3C XML conformance tests against the new Scanner pipeline'>
    <mkdir dir='${test}/junit/results'/>
    <mkdir dir='${test}/output'/>
    <junit printsummary='yes' haltonfailure='no' fork='yes' showoutput='true'
           failureproperty='conformance.tests.failed'>
      <sysproperty key='gonzalez.conformance.parser' value='scanner'/>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${build.xslt}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${test}/conformance/classes'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
      </classpath>
      <formatter type='xml'/>
      <formatter type='plain' usefile='false'/>
      <batchtest fork='yes' todir='${test}/junit/results'>
        <fileset dir='${test}/conformance/src'>
          <include name='**/XMLConformanceTest.java'/>
        </fileset>
      </batchtest>
    </junit>

    <echo message=''/>
    <echo message='Conformance report written to ${test}/output/xml-conformance-report-scanner.txt'/>
    <echo message=''/>
    <echo message='=== XML Conformance Test Statistics (Scanner pipeline) ==='/>
    <echo message=''/>
    <available file='${test}/output/conformance-statistics-scanner.txt' property='scanner.stats.file.exists'/>
    <loadfile property='scanner.stats.content' srcFile='${test}/output/conformance-statistics-scanner.txt'
              failonerror='false' quiet='true'/>
    <echo message='${scanner.stats.content}'/>

    <!-- Deliberately no <fail> here while the Conformance hardening phase is
         in progress - this target is for measuring/iterating, not gating. -->
  </target>

  <!-- Main test target: unit + conformance -->
  <target name='test' depends='test-unit,test-conformance' description='Run all tests'>
    <echo message='All tests complete'/>
  </target>
  
  <!-- XSLT Conformance Tests -->
  <target name='check-xslt30-test'>
    <fail unless='env.XSLT30_TEST_DIR'
          message='XSLT30_TEST_DIR is not set; set it to the xslt30-test checkout directory.'/>
    <available file='${env.XSLT30_TEST_DIR}/catalog.xml' property='xslt30test.exists'/>
    <fail unless='xslt30test.exists' 
          message='XSLT test suite catalog not found at ${env.XSLT30_TEST_DIR}/catalog.xml'/>
  </target>

  <target name='test-xslt' depends='check-xslt30-test,conformance-build' description='Run XSLT conformance tests'>
    <mkdir dir='${test}/junit/results'/>
    <mkdir dir='${test}/output'/>
    <mkdir dir='${test}/output/xslt-temp'/>
    <junit printsummary='yes' haltonfailure='no' fork='yes' showoutput='true'
           dir='${test}/output/xslt-temp'>
      <sysproperty key="project.basedir" value="${basedir}"/>
      <sysproperty key="xslt.skip" value="${xslt.skip}"/>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${build.xslt}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${test}/conformance/classes'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
      </classpath>
      <formatter type='xml'/>
      <formatter type='plain' usefile='false'/>
      <batchtest fork='yes' todir='${test}/junit/results'>
        <fileset dir='${test}/conformance/src'>
          <include name='**/XSLTConformanceTest.java'/>
        </fileset>
      </batchtest>
    </junit>
    <delete dir='${test}/output/xslt-temp' quiet='true'/>
    
    <echo message=''/>
    <echo message='XSLT conformance report written to ${test}/output/xslt-conformance-report.txt'/>
    <echo message=''/>
    <available file='${test}/output/xslt-conformance-statistics.txt' property='xslt.stats.exists'/>
    <loadfile property='xslt.stats.content' srcFile='${test}/output/xslt-conformance-statistics.txt' 
              failonerror='false' quiet='true'/>
    <echo message='${xslt.stats.content}'/>
  </target>
  
  <!-- Filtered XSLT tests - use these for quick targeted testing -->
  <!-- Usage: ant test-xslt10, ant test-xslt20, ant test-xslt30 -->
  <!-- Or: ant test-xslt-filter -Dxslt.filter=namespace -Dxslt.version=1.0 -->
  
  <target name='test-xslt10' depends='check-xslt30-test,conformance-build' description='Run XSLT 1.0 tests only'>
    <mkdir dir='${test}/junit/results'/>
    <mkdir dir='${test}/output'/>
    <mkdir dir='${test}/output/xslt-temp'/>
    <junit printsummary='yes' haltonfailure='no' fork='yes' showoutput='true'
           dir='${test}/output/xslt-temp'>
      <sysproperty key="xslt.version" value="1.0"/>
      <sysproperty key="project.basedir" value="${basedir}"/>
      <sysproperty key="xslt.skip" value="${xslt.skip}"/>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${build.xslt}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${test}/conformance/classes'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
      </classpath>
      <formatter type='plain' usefile='false'/>
      <batchtest fork='yes' todir='${test}/junit/results'>
        <fileset dir='${test}/conformance/src'>
          <include name='**/XSLTConformanceTest.java'/>
        </fileset>
      </batchtest>
    </junit>
    <delete dir='${test}/output/xslt-temp' quiet='true'/>
    <echo message='Report: ${test}/output/xslt-conformance-report.txt'/>
  </target>
  
  <target name='test-xslt20' depends='check-xslt30-test,conformance-build' description='Run XSLT 2.0 tests only'>
    <mkdir dir='${test}/junit/results'/>
    <mkdir dir='${test}/output'/>
    <mkdir dir='${test}/output/xslt-temp'/>
    <junit printsummary='yes' haltonfailure='no' fork='yes' showoutput='true'
           dir='${test}/output/xslt-temp'>
      <sysproperty key="xslt.version" value="2.0"/>
      <sysproperty key="project.basedir" value="${basedir}"/>
      <sysproperty key="xslt.skip" value="${xslt.skip}"/>
      <classpath>
        <pathelement location='${build.core}'/>
        <pathelement location='${build.xslt}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${test}/conformance/classes'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
      </classpath>
      <formatter type='plain' usefile='false'/>
      <batchtest fork='yes' todir='${test}/junit/results'>
